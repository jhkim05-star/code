{
  "name": "tokyo-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage,functions 'node tests/integration.mjs'",
    "deploy": "firebase deploy --only firestore:rules,storage,functions,hosting"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.33.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
