# Set real values ONLY in the hosting provider's private Variables/Secrets UI.
# The one operator API key is never shared with family devices.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
SIP_PUBLIC_ORIGIN=https://your-app.example
SIP_MASTER_KEY=
SIP_FAMILY_CODE=
SIP_DATA_DIR=/data/sip
HOST=0.0.0.0
PORT=8134
# Cost controls: reservations count failed/time-out calls conservatively.
SIP_DAILY_ANALYSES=10
SIP_MONTHLY_ANALYSES=200
SIP_DAILY_REVIEWS=3
SIP_MONTHLY_REVIEWS=30
SIP_MAX_DEVICES=20
SIP_SESSION_DAYS=90
# Change this (or FAMILY_CODE) to revoke all approved devices.
SIP_FAMILY_EPOCH=1
