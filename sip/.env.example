# Store actual values in your hosting provider's secret settings, not in Git.
SIP_PUBLIC_ORIGIN=https://your-domain.example
SIP_MASTER_KEY=
SIP_INVITE_CODE=
SIP_DATA_DIR=/data/sip
HOST=0.0.0.0
PORT=8134
OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-2.5-flash
# Optional Google identity login. Does not grant Gemini API quota.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only enable after hosted-app approval and registration.
SIP_CHATGPT_APPROVED=0
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
OPENAI_APPROVED_SCOPES=openid profile email
